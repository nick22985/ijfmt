#!/usr/bin/env bash
# install — Build ijfmt in release mode and install it alongside your code styles.
#
# Does three things:
#   1. cargo build --release, then copies the binary into BIN_DIR (default ~/.local/bin)
#   2. Copies every style XML in tests/fmt/ and tests/fmt/private/ into
#      ~/.config/ijfmt/styles/, where ijfmt resolves style names from
#   3. With --default-style NAME, writes ~/.config/ijfmt/config so every project
#      without its own .idea/codeStyles setup uses NAME
#
# Styles are installed under their *scheme name* (the name= attribute on
# <code_scheme>), not their source filename, because that is the name IntelliJ
# writes into .idea/codeStyles/codeStyleConfig.xml and the name ijfmt looks up.
#
# Options:
#   --default-style NAME   Set NAME as the global default in ~/.config/ijfmt/config
#   --dry-run              Show what would happen without writing anything
#   --no-bin               Skip the binary build/install, styles only
#   --no-styles            Skip the style install, binary only
#   --styles-dir DIR       Install styles here instead of ~/.config/ijfmt/styles
#   --bin-dir DIR          Install the binary here instead of ~/.local/bin
#
# Environment:
#   IJFMT_STYLES_DIR       Same as --styles-dir
#   XDG_CONFIG_HOME        Honoured, same as ijfmt itself
#   BIN_DIR                Same as --bin-dir
#
# Examples:
#   ./install
#   ./install --default-style Custom
#   ./install --dry-run
#   ./install --no-bin

set -euo pipefail
shopt -s nullglob

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ijfmt"

DRY_RUN=0
DO_BIN=1
DO_STYLES=1
DEFAULT_STYLE=""
STYLES_DIR="${IJFMT_STYLES_DIR:-$CONFIG_DIR/styles}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --default-style)   DEFAULT_STYLE="$2"; shift 2 ;;
        --dry-run)         DRY_RUN=1; shift ;;
        --no-bin)          DO_BIN=0; shift ;;
        --no-styles)       DO_STYLES=0; shift ;;
        --styles-dir)      STYLES_DIR="$2"; shift 2 ;;
        --bin-dir)         BIN_DIR="$2"; shift 2 ;;
        -h|--help)         sed -n '2,33p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
        *)                 echo "unknown option: $1 (try --help)" >&2; exit 2 ;;
    esac
done

run() {
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "  would run: $*"
    else
        "$@"
    fi
}

# Read the name= attribute off the root <code_scheme> element.
scheme_name() {
    sed -n 's/.*<code_scheme[^>]*name="\([^"]*\)".*/\1/p' "$1" | head -1
}

# --- 1. binary ---------------------------------------------------------------
if [[ $DO_BIN -eq 1 ]]; then
    echo "==> Building release binary"
    run cargo build --release --manifest-path "$REPO_ROOT/Cargo.toml"

    echo "==> Installing binary into $BIN_DIR"
    run mkdir -p "$BIN_DIR"
    run install -m 755 "$REPO_ROOT/target/release/ijfmt" "$BIN_DIR/ijfmt"

    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) echo "  note: $BIN_DIR is not on your PATH" ;;
    esac
fi

# --- 2. styles ---------------------------------------------------------------
if [[ $DO_STYLES -eq 1 ]]; then
    echo "==> Installing styles into $STYLES_DIR"
    run mkdir -p "$STYLES_DIR"

    installed=0
    names=()
    for src in "$REPO_ROOT"/tests/fmt/*.xml "$REPO_ROOT"/tests/fmt/private/*.xml; do
        name="$(scheme_name "$src")"
        if [[ -z "$name" ]]; then
            echo "  skip $(basename "$src") (no <code_scheme name=...>)"
            continue
        fi

        dest="$STYLES_DIR/$name.xml"
        label="$(basename "$src")"
        [[ "$label" != "$name.xml" ]] && label="$label -> $name.xml"

        if [[ -f "$dest" ]] && cmp -s "$src" "$dest"; then
            echo "  ok   $label (up to date)"
        else
            [[ -f "$dest" ]] && echo "  update $label" || echo "  add  $label"
            run cp "$src" "$dest"
        fi
        names+=("$name")
        installed=$((installed + 1))
    done

    if [[ $installed -eq 0 ]]; then
        echo "  no style XMLs found under tests/fmt/"
    fi
fi

# --- 3. global default style -------------------------------------------------
if [[ -n "$DEFAULT_STYLE" ]]; then
    echo "==> Setting global default style to $DEFAULT_STYLE"

    if [[ $DO_STYLES -eq 1 && ${#names[@]} -gt 0 ]]; then
        found=0
        for n in "${names[@]}"; do
            [[ "$n" == "$DEFAULT_STYLE" ]] && found=1
        done
        if [[ $found -eq 0 ]]; then
            echo "error: no style named '$DEFAULT_STYLE' among the installed styles:" >&2
            printf '       %s\n' "${names[@]}" >&2
            exit 1
        fi
    fi

    run mkdir -p "$CONFIG_DIR"
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "  would write $CONFIG_DIR/config with: style = $DEFAULT_STYLE"
    else
        cat > "$CONFIG_DIR/config" <<EOF
# ijfmt global config.
# Style used by any project without its own .idea/codeStyles/codeStyleConfig.xml.
# Resolved against $STYLES_DIR, then the IntelliJ codestyles directory.
style = $DEFAULT_STYLE
EOF
        echo "  wrote $CONFIG_DIR/config"
    fi
fi

echo
if [[ $DRY_RUN -eq 1 ]]; then
    echo "Dry run — nothing was written."
else
    echo "Done."
    if [[ -z "$DEFAULT_STYLE" ]]; then
        echo "Set a global default for every project with:"
        echo "  ./install --default-style Custom"
    fi
    echo "A project overrides the global default via its own"
    echo '.idea/codeStyles/codeStyleConfig.xml PREFERRED_PROJECT_CODE_STYLE.'
fi
